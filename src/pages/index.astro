---
import siteCss from '../styles/site.css?raw';

const explorerUrl = 'https://explorer.solana.com/';
const sourceUrl = 'https://github.com/wutz-io/scheisscoin';
const baseUrl = './';
const languages = ['en', 'de'] as const;

const copy = {
  en: {
    nav: ['Tokenomics', 'Blog', 'Airdrop'],
    eyebrow: 'The unreasonably honest fun money',
    headline: ['Much Scheiss.', 'Zero value.'],
    hero: '100 sextillion digital $KACK on Solana Mainnet. No investment, no returns, no secret utility. Just a token to give to people who already have everything — except $KACK.',
    actions: ['Get $KACK', 'Inspect tokenomics', 'Chain Explorer ↗'],
    microcopy: 'No wallet connection. No purchase. Mainnet mint pending.',
    ticker: ['$KACK IS WORTHLESS', 'NO PRESALE', 'NO EXCHANGE', 'JUST FOR FUN'],
    stats: [['100 sextillion', 'displayed total supply'], ['€0', 'claimed value'], ['Solana Mainnet', 'not an exchange'], ['0', 'financial promises']],
    math: 'Math with very large numbers',
    tokenomicsTitle: 'Tokenomics without economic utility.',
    tokenomicsIntro: '$KACK uses Token-2022 with a transparent display multiplier. There is no custom smart contract, no transfer tax and no upgrade key. After the one-time mint, the raw supply is fixed.',
    allocation: ['project reserve', 'to give away'],
    distribution: [['Project reserve', '100%', '100,000,000,000,000,000,000,000 $KACK'], ['Investors', '0%', '0 $KACK'], ['Team vesting', '0%', '0 $KACK'], ['Liquidity', '0%', '0 $KACK']],
    facts: [['Fixed supply', '100 trillion raw units × 1 billion UI multiplier = 100 sextillion displayed $KACK. Both authorities are made immutable during minting.'], ['Mainnet', 'Mainnet SOL is used only for one-time account rent and transaction fees. $KACK has no promised value.'], ['No liquidity', 'No pool, no listing, no presale. Nobody should buy $KACK or treat it as an investment.']],
    quote: ['Other coins promise the future of finance.', ' $KACK does not even promise tomorrow.'],
    committee: '— Scheisscoin Technical Committee (one person)',
    loreEyebrow: 'From the Scheissiverse',
    loreTitle: 'Chronicle & fictional past.',
    loreIntro: 'Everything before August 11, 2026 is explicitly fictional project lore. No backdated success stories, no invented community.',
    lore: [['August 11, 2026', 'PROTOCOL', 'The supply was very reasonably set to 100 sextillion', 'After several seconds of careful planning, the tokenomics are settled: a lot of $KACK, no price and no artificial scarcity. The mint authority will be disabled after minting.'], ['December 31, 2025', 'FICTIONAL LORE', 'Proof of Scheiss reaches theoretical maturity', 'The research year ended with a breakthrough: a meme needs no consensus mechanism when it is just an intentionally useless token.'], ['May 17, 2025', 'FICTIONAL LORE', 'Community unanimously decides nothing', 'The first governance call that never happened successfully avoided roadmaps, Discord moderation and ten-tier ambassador programs.'], ['April 1, 2024', 'FICTIONAL LORE', 'Scheisspaper v0.0 published and immediately ignored', "The original concept introduced utility, staking and revolutionary AI. Then all three terms were deleted. That was the year's most important technical upgrade."]],
    event: 'Community Event #000',
    airdropTitle: 'The first $KACK airdrop will happen eventually.',
    airdropText: 'No token has been minted yet. Once the Mainnet mint exists, $KACK can be distributed manually and free of charge to Solana Mainnet addresses. There is no registration and no paid participation.',
    status: 'Status', statusValue: 'PREPARING MAINNET', statusNote: 'Mint address follows after deployment',
    disclaimerTitle: 'A serious note:',
    disclaimer: '$KACK is a technical fun project on Solana Mainnet. The token has no guaranteed or expected monetary value, grants no rights and is not sold. Do not send SOL or money to anyone offering $KACK.',
    footer: 'Made in Munich. No roadmap. No Discord. No nonsense.', source: 'Source code ↗',
  },
  de: {
    nav: ['Tokenomics', 'Blog', 'Airdrop'],
    eyebrow: 'Das unvernünftig ehrliche Spaßgeld',
    headline: ['Viel Scheiss.', 'Null Wert.'],
    hero: '100 Trilliarden digitale $KACK auf Solana Mainnet. Kein Investment, keine Rendite, keine geheime Utility. Nur ein Token für Menschen, die schon alles haben — außer $KACK.',
    actions: ['$KACK bekommen', 'Tokenomics prüfen', 'Chain Explorer ↗'],
    microcopy: 'Keine Wallet-Verbindung. Kein Kauf. Mainnet-Mint steht aus.',
    ticker: ['$KACK IST WERTLOS', 'KEIN PRESALE', 'KEINE BÖRSE', 'NUR ZUM SPASS'],
    stats: [['100 Trilliarden', 'angezeigter Gesamtbestand'], ['0 €', 'behaupteter Wert'], ['Solana Mainnet', 'keine Börse'], ['0', 'Finanzversprechen']],
    math: 'Mathematik mit sehr großen Zahlen',
    tokenomicsTitle: 'Tokenomics ohne ökonomischen Nutzen.',
    tokenomicsIntro: '$KACK nutzt Token-2022 mit einem transparenten Anzeige-Multiplikator. Es gibt keinen eigenen Smart Contract, keine Transfersteuern und keine Upgrade-Keys. Nach dem einmaligen Mint ist der Rohbestand fix.',
    allocation: ['Projektreserve', 'zum Verschenken'],
    distribution: [['Projektreserve', '100 %', '100.000.000.000.000.000.000.000 $KACK'], ['Investoren', '0 %', '0 $KACK'], ['Team-Vesting', '0 %', '0 $KACK'], ['Liquidität', '0 %', '0 $KACK']],
    facts: [['Fixer Supply', '100 Billionen Roh-Einheiten × 1 Milliarde UI-Faktor = 100 Trilliarden angezeigte $KACK. Beide Authorities werden beim Mint unveränderlich gesetzt.'], ['Mainnet', 'Mainnet-SOL wird nur für einmalige Account-Miete und Transaktionsgebühren genutzt. $KACK hat keinen zugesicherten Wert.'], ['Keine Liquidität', 'Kein Pool, kein Listing, kein Presale. Niemand soll $KACK kaufen oder als Anlage behandeln.']],
    quote: ['Andere Coins versprechen die Zukunft des Finanzsystems.', ' $KACK verspricht nicht einmal morgen.'],
    committee: '— Scheisscoin Technical Committee (eine Person)',
    loreEyebrow: 'Aus dem Scheissiversum',
    loreTitle: 'Chronik & erfundene Vergangenheit.',
    loreIntro: 'Alles vor dem 11. August 2026 ist ausdrücklich fiktive Projekt-Lore. Keine rückdatierten Erfolgsmeldungen, keine erfundene Community.',
    lore: [['11. August 2026', 'PROTOKOLL', 'Der Supply wurde völlig vernünftig auf 100 Trilliarden festgelegt', 'Nach mehreren Sekunden sorgfältiger Planung steht die Tokenomics: sehr viele $KACK, kein Preis und keine künstliche Knappheit. Nach dem Mint wird die Mint-Authority abgeschaltet.'], ['31. Dezember 2025', 'FIKTIVE LORE', 'Proof of Scheiss erreicht die theoretische Marktreife', 'Das Forschungsjahr endete mit einer bahnbrechenden Erkenntnis: Ein Meme braucht keinen Konsensmechanismus, wenn es nur ein absichtlich nutzloser Token ist.'], ['17. Mai 2025', 'FIKTIVE LORE', 'Community beschließt einstimmig, nichts zu entscheiden', 'Beim ersten nicht stattgefundenen Governance-Call wurde erfolgreich auf Roadmaps, Discord-Moderation und zehnstufige Ambassador-Programme verzichtet.'], ['1. April 2024', 'FIKTIVE LORE', 'Scheisspaper v0.0 veröffentlicht und sofort ignoriert', 'Das ursprüngliche Konzept führte Utility, Staking und revolutionäre KI ein. Danach wurden alle drei Begriffe gestrichen. Das war das wichtigste technische Upgrade des Jahres.']],
    event: 'Community Event #000',
    airdropTitle: 'Der erste $KACK-Airdrop kommt irgendwann.',
    airdropText: 'Noch wurde kein Token geprägt. Sobald der Mainnet-Mint existiert, können $KACK kostenlos und manuell an Solana-Mainnet-Adressen verteilt werden. Es gibt keine Registrierung und keine bezahlte Teilnahme.',
    status: 'Status', statusValue: 'MAINNET WIRD VORBEREITET', statusNote: 'Mint-Adresse folgt nach Deployment',
    disclaimerTitle: 'Ernst gemeinter Hinweis:',
    disclaimer: '$KACK ist ein technisches Spaßprojekt auf Solana Mainnet. Der Token besitzt keinen zugesicherten oder erwarteten Geldwert, gewährt keine Rechte und wird nicht verkauft. Sende kein SOL und kein Geld an Personen, die $KACK anbieten.',
    footer: 'Made in München. Keine Roadmap. Kein Discord. Kein Quatsch.', source: 'Quellcode ↗',
  },
};
---

<!doctype html>
<html lang="en" data-language="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="$KACK is a worthless fun token on Solana Mainnet. No investment, no presale." />
    <meta name="theme-color" content="#0a0014" />
    <link rel="icon" href={`${baseUrl}favicon.svg`} type="image/svg+xml" />
    <title>Scheisscoin — Much Scheiss. Zero Value.</title>
    <style is:inline set:html={siteCss}></style>
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Scheisscoin home"><img class="brand-icon" src={`${baseUrl}favicon.svg`} alt="" /><span>SCHEISSCOIN</span></a>
      <nav aria-label="Main navigation">{languages.map((language) => copy[language].nav.map((item, index) => <a data-lang={language} href={['#tokenomics', '#lore', '#airdrop'][index]}>{item}</a>))}</nav>
      <div class="header-actions"><div class="language-switch" role="group" aria-label="Language"><button class="active" data-language-button="en" type="button">EN</button><button data-language-button="de" type="button">DE</button></div><a class="header-link" href={sourceUrl}>GitHub ↗</a></div>
    </header>

    <main>
      <section class="hero" id="top">
        <div class="hero-copy">
          {languages.map((language) => { const t = copy[language]; return <div data-lang={language}><p class="eyebrow"><span></span>{t.eyebrow}</p><h1>{t.headline[0]}<br /><em>{t.headline[1]}</em></h1><p class="hero-text">{t.hero}</p><div class="hero-actions"><a class="button primary" href="#airdrop">{t.actions[0]}</a><a class="button secondary" href="#tokenomics">{t.actions[1]}</a><a class="button secondary" href={explorerUrl} target="_blank" rel="noreferrer">{t.actions[2]}</a></div><p class="microcopy">{t.microcopy}</p></div>; })}
        </div>
        <div class="coin-stage" aria-label="Abstract Scheisscoin coin"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="coin"><span class="coin-small">$</span><strong>K</strong><span class="coin-label">$KACK</span></div><span class="float-label label-one">WUTZ!</span><span class="float-label label-two">MAINNET</span></div>
      </section>

      {languages.map((language) => <section class="ticker" data-lang={language} aria-label="Important notice">{copy[language].ticker.map((item) => <span>{item}<b>✦</b></span>)}</section>)}
      {languages.map((language) => <section class="stats" data-lang={language} aria-label="Scheisscoin stats">{copy[language].stats.map(([value, label]) => <div class="stat"><strong>{value}</strong><span>{label}</span></div>)}</section>)}

      <section class="section tokenomics" id="tokenomics">
        {languages.map((language) => { const t = copy[language]; return <div data-lang={language}><div class="section-heading"><p class="eyebrow"><span></span>{t.math}</p><h2>{t.tokenomicsTitle}</h2><p>{t.tokenomicsIntro}</p></div><div class="token-grid"><div class="allocation-card"><div class="allocation-visual"><span>100 %</span><small>{t.allocation[0]}<br />{t.allocation[1]}</small></div></div><div class="distribution">{t.distribution.map(([name, percentage, amount]) => <div class="distribution-row"><span>{name}</span><strong>{percentage}</strong><small>{amount}</small></div>)}</div></div><div class="facts">{t.facts.map(([title, text], index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div>; })}
      </section>

      {languages.map((language) => { const t = copy[language]; return <section class="manifesto" data-lang={language}><p>THE KACKPAPER</p><blockquote>{t.quote[0]}<em>{t.quote[1]}</em></blockquote><div class="manifesto-sign">{t.committee}</div></section>; })}

      <section class="section lore" id="lore">{languages.map((language) => { const t = copy[language]; return <div data-lang={language}><div class="section-heading split-heading"><div><p class="eyebrow"><span></span>{t.loreEyebrow}</p><h2>{t.loreTitle}</h2></div><p>{t.loreIntro}</p></div><div class="post-list">{t.lore.map(([date, tag, title, text], index) => <article class="post"><div class="post-number">{String(index + 1).padStart(2, '0')}</div><div class="post-meta"><time>{date}</time><span>{tag}</span></div><div class="post-copy"><h3>{title}</h3><p>{text}</p></div></article>)}</div></div>; })}</section>

      <section class="section airdrop" id="airdrop">{languages.map((language) => { const t = copy[language]; return <div class="drop-card" data-lang={language}><div><p class="eyebrow light"><span></span>{t.event}</p><h2>{t.airdropTitle}</h2><p>{t.airdropText}</p></div><div class="drop-status"><span>{t.status}</span><strong>{t.statusValue}</strong><small>{t.statusNote}</small></div></div>; })}</section>
      {languages.map((language) => { const t = copy[language]; return <section class="disclaimer" data-lang={language}><strong>{t.disclaimerTitle}</strong><p>{t.disclaimer}</p></section>; })}
    </main>

    <footer><a class="brand" href="#top"><img class="brand-icon" src={`${baseUrl}favicon.svg`} alt="" /><span>SCHEISSCOIN</span></a>{languages.map((language) => <p data-lang={language}>{copy[language].footer}</p>)}{languages.map((language) => <a data-lang={language} href={sourceUrl}>{copy[language].source}</a>)}</footer>

    <script>
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-language-button]');
      const setLanguage = (language: 'en' | 'de') => {
        document.documentElement.lang = language;
        document.documentElement.dataset.language = language;
        buttons.forEach((button) => {
          const active = button.dataset.languageButton === language;
          button.classList.toggle('active', active);
          button.setAttribute('aria-pressed', String(active));
        });
      };
      buttons.forEach((button) => button.addEventListener('click', () => setLanguage(button.dataset.languageButton === 'de' ? 'de' : 'en')));
      setLanguage('en');
    </script>
  </body>
</html>
